              <mxPoint x="830" y="699" />
              <mxPoint x="830" y="503" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w10" value="10   common ground" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=3;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="espgnd" target="mosgndh">
