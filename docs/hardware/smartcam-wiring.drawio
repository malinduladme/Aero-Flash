          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w9" value="9   gate drive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0066CC;strokeWidth=3;endArrow=block;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="espd26" target="mossig">
          <mxGeometry relative="1" as="geometry">
