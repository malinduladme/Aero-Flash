              <mxPoint x="800" y="737" />
              <mxPoint x="800" y="541" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="wc1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="cap" target="mtop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wc2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="cap" target="mton">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="how" value="&lt;b&gt;How this module works&lt;/b&gt;&#10;VIN passes straight through to V+.&#10;V− is the MOSFET drain, GND is its source.&#10;So the LED sits BETWEEN V+ and V−, and the&#10;MOSFET switches its low side on and off.&#10;&#10;All the heavy current stays in the screw&#10;terminals. The 3-pin header carries only&#10;the gate signal and its ground reference." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#B85450;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="400" width="300" height="190" as="geometry" />
        </mxCell>

        <mxCell id="order" value="&lt;b&gt;Wire in this order&lt;/b&gt;&#10;1–2  cell to TP4056        → check OUT+ reads 3.0–4.2 V&#10;3–4  TP4056 to MT3608&#10;5–6  MT3608 to MOS supply  → SET VOLTAGE NOW, no LED yet&#10;7–8  MOS to LED array&#10;9–10 ESP32 to MOS header   → touch SIG to 3V3: LEDs full on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9F5;strokeColor=#82B366;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Colours&lt;/b&gt;   red = positive · black = ground/return · blue = logic signal · dashed grey ○ = leave unconnected" style="text;html=1;fontSize=12;align=left;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="820" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Battery divider (optional)" id="divider">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="d0" />
        <mxCell id="d1" parent="d0" />

        <mxCell id="dt" value="Battery sense divider — optional" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="d1">
          <mxGeometry x="40" y="30" width="600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ds" value="Skip this and you lose only battery reporting; everything else works. D34 is on ADC1, which matters — ADC2 is claimed by the WiFi driver, so a divider on an ADC2 pin reads fine in BLE mode and fails silently in WiFi mode." style="text;html=1;fontSize=13;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="d1">
          <mxGeometry x="40" y="66" width="760" height="50" as="geometry" />
        </mxCell>

        <mxCell id="src" value="TP4056  OUT+" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;fontStyle=1" vertex="1" parent="d1">
          <mxGeometry x="60" y="190" width="170" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="R1   100 kΩ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="d1">
          <mxGeometry x="330" y="190" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="mid" value="midpoint" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;fontSize=12;" vertex="1" parent="d1">
          <mxGeometry x="550" y="190" width="100" height="44" as="geometry" />
        </mxCell>
        <mxCell id="adc" value="ESP32  D34" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;fontStyle=1" vertex="1" parent="d1">
          <mxGeometry x="760" y="190" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="R2   100 kΩ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="d1">
          <mxGeometry x="535" y="340" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="dg" value="MOS Module  GND&#10;(3-pin header)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;fontSize=13;fontStyle=1" vertex="1" parent="d1">
          <mxGeometry x="520" y="480" width="160" height="54" as="geometry" />
        </mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC0000;strokeWidth=3;endArrow=none;" edge="1" parent="d1" source="src" target="r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=3;endArrow=none;" edge="1" parent="d1" source="r1" target="mid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=3;endArrow=block;" edge="1" parent="d1" source="mid" target="adc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=3;endArrow=none;" edge="1" parent="d1" source="mid" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=3;endArrow=none;" edge="1" parent="d1" source="r2" target="dg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dn" value="Any matched pair works — 10 k, 47 k or 100 k. Higher values draw less current from the cell." style="text;html=1;fontSize=13;align=left;verticalAlign=top;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="d1">
          <mxGeometry x="760" y="340" width="280" height="60" as="geometry" />
        </mxCell>
