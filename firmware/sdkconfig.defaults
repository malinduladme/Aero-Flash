CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# This board has 4 MB of flash and a Boya chip. Without these two, every boot
# logs a size-mismatch warning and an unsupported-chip warning — noise that
# would sit on top of the PASS/FAIL self-test output we read from serial later.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# NimBLE is far smaller than Bluedroid and gives direct control over the
# connection interval, which dominates BLE latency.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# The LED current surge can dip the rail; keep brownout detection on but at the
# lowest threshold so a legitimate flash does not reset the board.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_2=y

# Lets the flash off-timer run from the timer ISR rather than a task, so no
# amount of task starvation can leave the LED array switched on. Required by
# flash_driver in Task 4.
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
